    {
      "name": "Get Movie Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Returned movie matches requested ID\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    const requestedId = parseInt(pm.collectionVariables.get(\"movie_id\"));\r",
              "    pm.expect(jsonData.id).to.equal(requestedId);\r",
              "});\r",
              "\r",
              "pm.test(\"Movie details have expected fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"title\");\r",
              "    pm.expect(jsonData).to.have.property(\"overview\");\r",
              "    pm.expect(jsonData).to.have.property(\"release_date\");\r",
              "    pm.expect(jsonData).to.have.property(\"runtime\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
