  "item": [
    {
      "name": "Trending Movies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has results array\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"results\");\r",
              "    pm.expect(jsonData.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is under 1000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "\r",
              "pm.test(\"Each result has required fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    jsonData.results.forEach(function (movie) {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"vote_average\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Save first movie ID for next request\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    \r",
              "    pm.expect(jsonData.results.length).to.be.above(0);\r",
              "    \r",
              "    const firstMovieId = jsonData.results[0].id;\r",
              "    pm.collectionVariables.set(\"movie_id\", firstMovieId);\r",
              "    \r",
              "    console.log(\"Saved movie_id:\", firstMovieId);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
